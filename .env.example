# ==============================================================================
# Master Environment Variables Configuration (.env.example)
# AcademyIO Webinar & Seminar E-Commerce Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# Medusa.js Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=9000
NODE_ENV=development

# PostgreSQL Connection String (Database must exist prior to running migrations)
DATABASE_URL=postgres://username:password@127.0.0.1:5432/academyio_medusa

# Redis URL (Optional for development; Medusa utilizes in-memory fallback if unset)
REDIS_URL=redis://localhost:6379

# JWT & Cookie Encryption Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
COOKIE_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# Payment Secret Encryption Key (Generate with: openssl rand -hex 32)
PAYMENT_ENCRYPTION_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# CORS Whitelists
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# Telemetry
MEDUSA_DISABLE_TELEMETRY=1

# Cloudflare Turnstile (Private Secret Key)
TURNSTILE_SECRET_KEY=<YOUR_TURNSTILE_SECRET_KEY>

# S3 / Cloudflare R2 Private Object Storage
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<YOUR_S3_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<YOUR_S3_SECRET_ACCESS_KEY>
S3_BUCKET=academyio-media
S3_REGION=auto

# ------------------------------------------------------------------------------
# Next.js Storefront Configuration (storefront/.env.local)
# ------------------------------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (Created during seeding or retrieved from Medusa Admin)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=<YOUR_MEDUSA_PUBLISHABLE_KEY>

# Storefront Base URL & Default Region
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=us

# Next.js Cache Revalidation Secret (Generate with: openssl rand -hex 32)
REVALIDATE_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# Cloudflare Turnstile Public Site Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<YOUR_TURNSTILE_SITE_KEY>

# Stripe Integration
# NEXT_PUBLIC_STRIPE_KEY=pk_test_...
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
